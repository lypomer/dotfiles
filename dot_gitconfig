[core]
  editor = zed --wait
[diff]
  tool = default-difftool
[difftool "default-difftool"]
  cmd = zed --wait --diff $LOCAL $REMOTE
[merge]
  tool = zed
[mergetool "zed"]
  cmd = zed --wait --merge $REMOTE $LOCAL $BASE $MERGED
[alias]
  gud = help
[init]
  defaultBranch = main
[fetch]
  prune = true
